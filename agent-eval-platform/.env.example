# 复制为 .env，docker compose 会自动读取
# cp .env.example .env

# ── Runner 鉴权（server 和 runner 必须一致）──────────────────────────────
RUNNER_SECRET=dev-runner-secret-change-me-in-prod

# ── API CORS 白名单（逗号分隔；生产必须替换为真实域名）──────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 真实 Agent 评测时打开（mock profile 不需要）─────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── LangGraph scaffold 的 LLM 后端（默认 anthropic）────────────────────
# LG_MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-...
